# Agency environment configuration.
#
# Copy this file to `.env` in the directory you run agency from (e.g. the repo
# root) and adjust the values. `.env` is gitignored; this `.env.example` is the
# committed template. Real environment variables always take precedence over
# values set here.

# Ordered, colon-separated list of directories Agency searches (in order) for
# the model files referenced by a workflow's `models:` section. The first
# directory that contains the file wins; element 0 is the default/primary
# location. Default when unset: ~/.llama-cpp/models
AGENCY_MODELS_DIRS=~/.llama-cpp/models

# llama.cpp server binary used when Agency auto-starts a local server for a
# model whose declared endpoint is unreachable. Default: llama-server (resolved
# on PATH).
LLAMA_CPP_SERVER_PATH=llama-server
